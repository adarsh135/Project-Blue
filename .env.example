# ---------------------------------------------------------------------------
# Project Blue — environment configuration
# Copy to .env (never commit .env) and fill in what you need.
#
# Blue runs with ZERO keys: when no model provider is configured it falls back
# to the built-in "Blue Local Engine" so the app is always usable.
# ---------------------------------------------------------------------------

PORT=4000
HOST=0.0.0.0
PUBLIC_URL=http://localhost:4000

# Optional hosted database. Leave unset for local SQLite. Vercel production
# requires a durable PostgreSQL/Neon URL; do not rely on its ephemeral filesystem.
DATABASE_URL=
# POSTGRES_URL=  # also accepted by the app

# Session signing secret. If unset, one is generated and persisted to
# data/.session-secret locally. Vercel production requires a stable 32+ character secret.
BLUE_SESSION_SECRET=

# How long a login session stays valid (hours).
SESSION_TTL_HOURS=168

# ---- Model providers (pick one, or several and switch per-chat) ------------
# OpenAI-compatible (OpenAI, Groq, Together, OpenRouter, vLLM, LM Studio...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Self-hosted models
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

# ---- Search tool providers -------------------------------------------------
# Without one of these, the web_search tool uses the keyless DuckDuckGo
# endpoint (best effort) and everything else degrades gracefully.
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# Force the offline engine even if provider keys exist (true/false).
BLUE_FORCE_LOCAL_ENGINE=false
