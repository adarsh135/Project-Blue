# ---------------------------------------------------------------------------
# Project Blue — environment configuration
# Copy to .env (never commit .env) and fill in what you need.
#
# Blue runs with ZERO keys: when no model provider is configured it falls back
# to the built-in "Blue Local Engine" so the app is always usable.
# ---------------------------------------------------------------------------

PORT=4000
HOST=0.0.0.0
PUBLIC_URL=http://localhost:4000

# Session signing secret. If unset, one is generated and persisted to
# data/.session-secret (stable across restarts).
BLUE_SESSION_SECRET=

# How long a login session stays valid (hours).
SESSION_TTL_HOURS=168

# ---- Model providers (pick one, or several and switch per-chat) ------------
# The defaults below are the current models as of October 2026. Vendors retire
# IDs on their own schedule; if you point Blue at a retired model you will get
# an error naming the replacement, and /api/status flags it under stale_models.
#
# OpenAI-compatible (OpenAI, Groq, Together, OpenRouter, vLLM, LM Studio...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# gpt-4o-mini is deprecated upstream; GPT-5.6 Terra is the current balanced tier.
# For a non-OpenAI gateway set whatever model ID that gateway exposes.
OPENAI_MODEL=gpt-5.6-terra

ANTHROPIC_API_KEY=
# Claude 3.5 Sonnet and the whole Claude 3 generation have been retired.
ANTHROPIC_MODEL=claude-sonnet-5

GEMINI_API_KEY=
# Every Gemini 1.x model returns 404 (shut down 2025-09-29); 2.0 followed on
# 2026-06-01. Gemini 3.8 Flash is the current GA Flash model.
GEMINI_MODEL=gemini-3.8-flash

# Self-hosted models
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

# ---- Search tool providers -------------------------------------------------
# Recommended. Without one of these, web_search falls back to the keyless
# DuckDuckGo scrape, which DuckDuckGo rate-limits per IP and answers with an
# anti-bot challenge (HTTP 202) once a machine is flagged. Blue detects that and
# says so rather than reporting "no results", but a real backend is better.
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# Self-hosted SearXNG — keyless, dependable, and the best option if you would
# rather not hold a commercial search API key. Point this at your instance; the
# instance needs "json" in its search.formats setting.
#   docker run -d -p 8080:8080 searxng/searxng
# BLUE_SEARXNG_URL=http://localhost:8080

# Minimum spacing between keyless DuckDuckGo requests, in ms (default 3000).
# Hammering the endpoint is what trips the anomaly flag in the first place.
BLUE_SEARCH_MIN_INTERVAL_MS=3000

# Send the keyless DuckDuckGo lanes somewhere other than duckduckgo.com — a
# mirror, an egress proxy, or a local server in tests. Leave unset for the real
# host. When set, the public Instant Answer API is skipped.
# BLUE_SEARCH_DDG_BASE=

# Force the offline engine even if provider keys exist (true/false).
BLUE_FORCE_LOCAL_ENGINE=false
