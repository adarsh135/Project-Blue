# Copy to .env for `docker compose up`. Never commit the filled-in file.
#   cp .env.deploy.example .env
#   openssl rand -base64 48     # paste into BLUE_SESSION_SECRET
#   openssl rand -hex 32        # paste into SEARXNG_SECRET

# The name users type. Caddy gets a Let's Encrypt certificate for it
# automatically once this name's DNS points at the server.
DOMAIN=problue.run.place

# Used for Let's Encrypt expiry notices. Optional but recommended.
ACME_EMAIL=

# REQUIRED. Signs session cookies. Generate once and keep it stable —
# changing it logs every user out. If unset the app generates one and stores
# it in the data volume, which also works but is easier to lose.
BLUE_SESSION_SECRET=

# How long a login lasts, in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168

# ---- Model provider: set at most one to route through a real model ---------
# With none set, Blue runs its built-in offline engine and still works.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

# ---- Search ---------------------------------------------------------------
# SearXNG runs inside this compose stack and is the default search lane:
# keyless, and not subject to the per-IP throttling that scraping
# duckduckgo.com from a datacenter IP runs into. It listens on the compose
# network only — nothing is published to the host, so it is not a public
# search engine anyone else can use or abuse.
#
# REQUIRED. Signs SearXNG's own session cookies. Generate with:
#   openssl rand -hex 32
SEARXNG_SECRET=

# Pin the image after you have a version you trust, e.g.
#   SEARXNG_VERSION=2026.3.25-541c6c3cb
SEARXNG_VERSION=latest

# Leave commented to use the bundled instance. Uncomment only to point Blue at
# a different SearXNG; set it empty (BLUE_SEARXNG_URL=) to drop the lane and
# fall back to scraping DuckDuckGo.
#BLUE_SEARXNG_URL=http://searxng:8080

# Commercial search keys, if you have them, outrank SearXNG in the search
# chain (tavily > brave > serper > searxng > duckduckgo):
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
